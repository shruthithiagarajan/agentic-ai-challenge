# Copy to .env (never commit .env)

# --- Groq (Challenges 1-5): kept, commented out. To switch back: uncomment and set DESK_PROVIDER=groq ---
# GROQ_API_KEY=
# DESK_MODEL=openai/gpt-oss-120b

# --- Azure AI Foundry: GPT via the OpenAI SDK, Claude via the Anthropic SDK ---
DESK_PROVIDER=azure
AZURE_AI_API_KEY=
AZURE_OPENAI_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
AZURE_ANTHROPIC_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# Your deployment name. A model name starting with "claude" uses the Anthropic endpoint.
DESK_MODEL=gpt-6.2-sol
# Optional: Claude's max output tokens (default 16000)
DESK_MAX_TOKENS=

# --- One model per challenge (--model overrides; any role left unset falls back to DESK_MODEL) ---
DESK_MODEL_ONECALL=gpt-6.2-sol          # Ch1 one plain call (scripts/break_it.py)
DESK_MODEL_CHAT=claude-sonnet-5-5       # Ch2 desk chat
DESK_MODEL_EXTRACT=gpt-6.2-sol          # Ch3 desk extract
DESK_MODEL_RAG=claude-sonnet-5-5        # Ch4-5 desk ask + eval-rag answers
DESK_MODEL_REWRITE=gpt-6.2-sol          # Ch5 follow-up query rewriting
DESK_MODEL_JUDGE=gpt-6.2-sol            # Ch5 eval-rag faithfulness judge
DESK_MODEL_TOOLS=gpt-6.2-sol            # Ch6 desk tools / eval-tools (tool calling)
DESK_MODEL_AGENT=claude-sonnet-5-5      # Ch7 desk agent (the agent loop)

# Optional, USD per 1M tokens, for the cost estimate (footer shows n/a if unset)
DESK_PRICE_IN=
DESK_PRICE_OUT=

# Optional: where every tool call is logged (default data/tool_calls.jsonl; "off" disables)
DESK_TOOL_LOG=

# Optional: where desk agent saves email drafts (default meridian_desk_data/outbox; nothing is ever sent)
DESK_OUTBOX=

# Challenge 8 (MCP): bearer token for the meridian-ops HTTP server (fake tokens: meridian_desk_data/mcp/auth_tokens.json)
MERIDIAN_TOKEN=
